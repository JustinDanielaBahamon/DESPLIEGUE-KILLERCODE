# ============================================
# .env.example
# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas el archivo ".env" real a Git.
# ============================================

# ---------- MySQL ----------
MYSQL_DATABASE=multicapa_db
MYSQL_USER=multicapa_user
MYSQL_PASSWORD=change_me_user_pass
MYSQL_ROOT_PASSWORD=change_me_root_pass
MYSQL_PORT=3306

# ---------- Backend (Spring Boot) ----------
# Host y puerto vistos DESDE DENTRO de la red Docker (nombre del servicio, no localhost)
SPRING_DATASOURCE_HOST=database
SPRING_DATASOURCE_PORT=3306
SPRING_DATASOURCE_DB=${MYSQL_DATABASE}
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ---------- Frontend (React + Vite) ----------
# URL pública del backend, usada por el navegador del usuario
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=3000
