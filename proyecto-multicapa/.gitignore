# ============================================
# .gitignore raíz — proyecto-multicapa
# ============================================

# ---------- Variables de entorno / secretos ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Frontend (Node / Vite) ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.log
frontend/coverage/

# ---------- Backend (Maven / Java) ----------
backend/target/
backend/*.class
backend/.mvn/
backend/HELP.md
*.jar
*.war

# ---------- Base de datos ----------
database/backups/*.sql
!database/backups/.gitkeep

# ---------- Docker ----------
docker/**/*.log

# ---------- IDE / SO ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---------- Logs generales ----------
*.log
logs/
